# Copy this file to .env.local and fill in real values.
# Never commit a real .env file — only .env.example with placeholders.

# The Midnight network to connect the wallet to. This project has
# empirically confirmed `preview` works against a real funded Midnight
# testnet wallet (not `preprod`, which is what an older reference example
# used and produced a "Network ID mismatch" from Lace). Still confirm
# against your own Lace wallet's network settings (gear icon in the
# extension panel) before trusting this — see DEPLOYMENT.md's "Testnet
# lessons learned" section.
VITE_NETWORK_ID=preview

# Optional: the address of an already-deployed PredictionBoard contract to
# pre-populate the in-app match list with, so a single-match deployment
# works with zero extra setup. Participants can also add (or add more)
# match addresses directly in the app's match list — this is just a
# convenience seed, not a requirement. Deploying is separate organizer-only
# tooling — see web/deploy.html and DEPLOYMENT.md — not a code path inside
# this participant-facing app.
VITE_PREDICTION_BOARD_ADDRESS=

# Deliberately absent: VITE_MIDNIGHT_INDEXER_URL, VITE_MIDNIGHT_PROOF_SERVER_URL.
# These come from the connected wallet's own getConfiguration() call, not
# from app-level env vars — see web/src/wallet/connect.ts. A local proof
# server via Docker is still required — see DEPLOYMENT.md's Prerequisites.
